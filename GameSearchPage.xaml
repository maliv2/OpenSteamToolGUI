<UserControl x:Class="OpenSteamToolGUI.GameSearchPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="2,0,2,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock x:Name="Introduction" FontSize="15" Foreground="{DynamicResource UiMuted}" Margin="0,0,0,12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="QueryBox" Grid.Column="0" MinWidth="180" VerticalContentAlignment="Center" KeyDown="QueryBox_KeyDown"/>
          <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" MinWidth="104" Click="SearchButton_Click"/>
        </Grid>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Margin="2,0,2,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ServerStatus" Grid.Column="0" Foreground="{DynamicResource UiMuted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button x:Name="CheckServersButton" Grid.Column="1" Click="CheckServersButton_Click"/>
    </Grid>
    <DataGrid x:Name="ResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowHeight="76" SelectionChanged="ResultsGrid_SelectionChanged" MouseDoubleClick="ResultsGrid_MouseDoubleClick">
      <DataGrid.Columns>
        <DataGridTemplateColumn x:Name="ArtworkColumn" Width="132"><DataGridTemplateColumn.CellTemplate><DataTemplate>
          <Border Width="112" Height="54" CornerRadius="5" Background="{DynamicResource UiInput}" ClipToBounds="True">
            <Image Source="{Binding Artwork}" Stretch="UniformToFill"/>
          </Border>
        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn x:Name="AppIdColumn" Binding="{Binding AppId}" Width="100"/>
        <DataGridTextColumn x:Name="GameColumn" Binding="{Binding Name}" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <Grid Grid.Row="3" Margin="2,10,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ResultsMessage" Grid.Column="0" Foreground="{DynamicResource UiMuted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <Button x:Name="AddButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="AddButton_Click"/>
    </Grid>
  </Grid>
</UserControl>
