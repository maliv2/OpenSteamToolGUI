<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenSteamToolGUI</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><Compile Remove="tests\**\*.cs" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Core\Turkish.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="UpdateHelper.ps1" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\app.ico" /></ItemGroup>
</Project>
