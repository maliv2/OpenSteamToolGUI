<Window x:Class="OpenSteamToolGUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenSteamToolGUI" Title="OpenSteamTool GUI" Width="1000" Height="680" MinWidth="900" MinHeight="600" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop">

  <Window.Resources><local:LocalizedValueConverter x:Key="LocalizedValue"/></Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource UiSidebar}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,20,12,20"><TextBlock Text="OpenSteamTool" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource UiText}"/><TextBlock Text="GUI Manager" FontSize="10" Margin="4,5,0,0" Foreground="{DynamicResource UiMuted}"/></StackPanel>
        <ListBox x:Name="Nav" SelectionChanged="Nav_SelectionChanged" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource UiText}" FontSize="14" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="20,16,20,10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,14"><TextBlock Text="Your Steam workspace" Style="{StaticResource MutedText}" FontSize="12"/><TextBlock x:Name="PageTitle" FontSize="27" FontWeight="SemiBold" Margin="4,3,4,0"/></StackPanel>
      <Grid Grid.Row="1">
        <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Installation" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Manage your installation and keep it up to date." Style="{StaticResource MutedText}" Margin="4,3,4,12"/><TextBlock x:Name="SteamPathDisplay" FontSize="14"/>
          <TextBlock x:Name="SteamStateDisplay"/><TextBlock x:Name="ToolVersionDisplay"/></StackPanel><Button x:Name="SteamActionButton" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0,8,0" Click="SteamAction_Click"/></Grid></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Installation tools" FontSize="18" FontWeight="SemiBold"/>
          <WrapPanel Margin="0,9,0,0"><Button x:Name="ChooseSteamButton" Click="ChooseSteam_Click"/><Button x:Name="CheckReleaseButton" Click="CheckRelease_Click"/><Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Click="Install_Click"/><Button x:Name="RepairButton" Click="Install_Click"/><Button x:Name="DebugInstallButton" Click="InstallDebug_Click"/></WrapPanel>
          <TextBlock x:Name="ReleaseDisplay" FontSize="14" Margin="4,10"/>
          <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100" Margin="4"/>
          </StackPanel></Border><TextBlock x:Name="DashboardHint" Foreground="{DynamicResource UiMuted}" Margin="4,12"/>
        </StackPanel></ScrollViewer>
        <DockPanel x:Name="LibraryPage" Visibility="Collapsed"><StackPanel DockPanel.Dock="Top"><WrapPanel><TextBlock Text="Search games or AppID" VerticalAlignment="Center"/><TextBox x:Name="LibrarySearch" Width="210" TextChanged="LibrarySearch_TextChanged"/><ComboBox x:Name="LibraryFilter" Width="120" SelectionChanged="LibrarySearch_TextChanged"/><Button x:Name="RefreshLibraryButton" Click="RefreshLibrary_Click"/><Button x:Name="AddGameButton" Style="{StaticResource PrimaryButton}" Click="AddGame_Click"/><Button x:Name="ToggleGameButton" Click="ToggleGame_Click"/><Button x:Name="EditGameButton" Click="EditGame_Click"/><Button x:Name="RemoveGameButton" Click="RemoveGame_Click"/></WrapPanel><TextBlock x:Name="LibraryInfo"/></StackPanel><DataGrid x:Name="LibraryGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" Margin="4"><DataGrid.Columns><DataGridTextColumn Header="Game / Package" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="App IDs" Binding="{Binding DisplaySummary}" Width="2*"/><DataGridTextColumn Header="State" Binding="{Binding Status, Converter={StaticResource LocalizedValue}}" Width="*"/><DataGridTextColumn Header="File" Binding="{Binding SourcePath}" Width="3*"/></DataGrid.Columns></DataGrid></DockPanel>
        <DockPanel x:Name="ImportPage" Visibility="Collapsed"><StackPanel DockPanel.Dock="Top"><TextBlock x:Name="ImportHint"/><WrapPanel><Button x:Name="ChooseZipButton" Click="ChooseZip_Click"/><Button x:Name="SelectAllImportButton" Content="Select All" Click="SelectAllImport_Click"/><Button x:Name="SelectNoneImportButton" Content="Select None" Click="SelectNoneImport_Click"/><Button x:Name="AssignGameButton" Content="Assign AppID" Click="AssignGame_Click"/><Button x:Name="ApplyImportButton" Style="{StaticResource PrimaryButton}" Click="ApplyImport_Click"/><Button x:Name="ReplaceSelectedButton" Click="ReplaceSelected_Click"/><Button x:Name="KeepSelectedButton" Click="KeepSelected_Click"/></WrapPanel><TextBlock x:Name="ImportSource"/></StackPanel><DataGrid x:Name="ImportGrid" AutoGenerateColumns="False" Margin="4"><DataGrid.Columns><DataGridCheckBoxColumn ElementStyle="{StaticResource {x:Type CheckBox}}" EditingElementStyle="{StaticResource {x:Type CheckBox}}" Header="Add" Binding="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/><DataGridTextColumn Header="Game" Binding="{Binding Game, Converter={StaticResource LocalizedValue}}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, Converter={StaticResource LocalizedValue}}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="Auto" IsReadOnly="True"/><DataGridTextColumn Header="Source" Binding="{Binding ArchivePath}" Width="2*" IsReadOnly="True"/><DataGridTextColumn Header="Target" Binding="{Binding TargetPath}" Width="3*" IsReadOnly="True"/><DataGridTextColumn Header="Action" Binding="{Binding Action, Converter={StaticResource LocalizedValue}}" Width="*" IsReadOnly="True"/></DataGrid.Columns></DataGrid></DockPanel>
        <ScrollViewer x:Name="ConfigPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Logging" FontSize="18" FontWeight="Bold"/><ComboBox x:Name="LogLevel" Width="170" HorizontalAlignment="Left"/><TextBlock Text="Detailed logs require the upstream Debug release."/>
          <TextBlock Text="Manifest provider" FontSize="18" FontWeight="Bold"/><ComboBox x:Name="ManifestProvider" Width="200" HorizontalAlignment="Left"/>
          <UniformGrid Columns="2"><StackPanel><TextBlock Text="DNS timeout (ms)"/><TextBox x:Name="ResolveTimeout"/></StackPanel><StackPanel><TextBlock Text="Connect timeout (ms)"/><TextBox x:Name="ConnectTimeout"/></StackPanel><StackPanel><TextBlock Text="Send timeout (ms)"/><TextBox x:Name="SendTimeout"/></StackPanel><StackPanel><TextBlock Text="Receive timeout (ms)"/><TextBox x:Name="ReceiveTimeout"/></StackPanel></UniformGrid>
          </StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Additional Lua paths (TOML array)" FontSize="18" FontWeight="Bold"/><TextBox x:Name="LuaPaths"/>
          <TextBlock Text="Process injection" FontSize="18" FontWeight="Bold"/><CheckBox x:Name="InjectEnabled" Content="Enabled"/><TextBlock Text="x64 library"/><TextBox x:Name="LibraryX64"/><TextBlock Text="x86 library"/><TextBox x:Name="LibraryX86"/>
          </StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Metadata mirror URL template" FontSize="18" FontWeight="Bold"/><TextBox x:Name="RemoteTemplate"/>
          <TextBlock x:Name="NewerFeaturesInfo"/><CheckBox x:Name="StatsEnabled" Content="Use stats API"/><CheckBox x:Name="CloudEnabled" Content="Use CloudRedirect"/><TextBox x:Name="CloudLibrary"/>
</StackPanel></Border>          <WrapPanel><Button x:Name="SaveConfigButton" Style="{StaticResource PrimaryButton}" Click="SaveConfig_Click"/><Button x:Name="RawConfigButton" Click="RawConfig_Click"/><Button x:Name="ReloadConfigButton" Click="ReloadConfig_Click"/></WrapPanel>
        </StackPanel></ScrollViewer>
        <DockPanel x:Name="BackupsPage" Visibility="Collapsed"><StackPanel DockPanel.Dock="Top"><WrapPanel><Button x:Name="RefreshBackupsButton" Click="RefreshBackups_Click"/><Button x:Name="RestoreBackupButton" Style="{StaticResource PrimaryButton}" Click="RestoreBackup_Click"/></WrapPanel></StackPanel><DataGrid x:Name="BackupsGrid" AutoGenerateColumns="False" IsReadOnly="True" Margin="4"><DataGrid.Columns><DataGridTextColumn Header="Date (UTC)" Binding="{Binding CreatedUtc}" Width="*"/><DataGridTextColumn Header="Operation" Binding="{Binding Description, Converter={StaticResource LocalizedValue}}" Width="3*"/><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="2*"/></DataGrid.Columns></DataGrid></DockPanel>
        <DockPanel x:Name="DiagnosticsPage" Visibility="Collapsed"><StackPanel DockPanel.Dock="Top"><Button x:Name="RunDiagnosticsButton" Click="RunDiagnostics_Click" HorizontalAlignment="Left"/><Button x:Name="OpenLogsButton" Click="OpenLogs_Click" HorizontalAlignment="Left"/></StackPanel><TextBox x:Name="DiagnosticsText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></DockPanel>
        <ScrollViewer x:Name="AppSettingsPage" Visibility="Collapsed"><StackPanel><Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Appearance" FontSize="18" FontWeight="Bold"/><ComboBox x:Name="AppearanceBox" Width="220" HorizontalAlignment="Left" SelectionChanged="AppearanceBox_SelectionChanged"/>
          <TextBlock Text="Language" FontSize="18" FontWeight="Bold"/><ComboBox x:Name="LanguageBox" Width="240" HorizontalAlignment="Left" SelectionChanged="LanguageBox_SelectionChanged"/>
          <CheckBox x:Name="AutoUpdateCheck" Content="Check for updates on launch" Checked="PreferenceChanged" Unchecked="PreferenceChanged"/>
          <WrapPanel><Button x:Name="CheckAppUpdateButton" Click="CheckAppUpdate_Click"/><Button x:Name="InstallAppUpdateButton" Click="InstallAppUpdate_Click" IsEnabled="False"/></WrapPanel>
          <TextBlock x:Name="AppUpdateStatus" TextWrapping="Wrap" Margin="4,4,0,8"/>
          <TextBlock Text="Backup retention (records)"/><TextBox x:Name="RetentionBox" Width="100" HorizontalAlignment="Left" LostFocus="RetentionBox_LostFocus"/>
          </StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><WrapPanel><Button x:Name="SettingsSteamButton" Click="ChooseSteam_Click"/><Button x:Name="UninstallButton" Click="Uninstall_Click"/></WrapPanel>
          <TextBlock x:Name="UninstallHint" Foreground="{DynamicResource UiWarning}"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
      </Grid>
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource UiBorder}" Padding="3,8"><TextBlock x:Name="StatusText" Text="Ready"/></Border>
    </Grid>
  </Grid>
</Window>
